<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.8.xsd">
	<changeSet id="001_init_schema" author="yourname" runOnChange="false" runAlways="false">
		<sqlFile path="migrations/001_init_schema.sql" />
	</changeSet>

	<changeSet id="002_init_tables_views" author="yourname" runOnChange="false" runAlways="false">
		<sqlFile path="migrations/002_init_users.sql" />
	</changeSet>

    <changeSet id="003_drop_users_password" author="yourname" runOnChange="false" runAlways="false">
        <sqlFile path="migrations/003_drop_users_password.sql" />
        <rollback>
            <sql splitStatements="true" endDelimiter="GO">
                ALTER TABLE [users].[Users] ADD [Password] NVARCHAR(255) NOT NULL CONSTRAINT [DF_users_Users_Password] DEFAULT ('')
                GO
                ALTER VIEW [users].[v_Users] AS
                SELECT [User].[Id], [User].[IsActive], [User].[Login], [User].[Password], [User].[Email], [User].[Name]
                FROM [users].[Users] AS [User]
                GO
            </sql>
        </rollback>
    </changeSet>

    <changeSet id="004_users_email_nullable" author="yourname" runOnChange="false" runAlways="false">
        <sqlFile path="migrations/004_users_email_nullable.sql" />
        <rollback>
            <sql splitStatements="true" endDelimiter="GO">
                UPDATE [users].[Users] SET [Email] = N'' WHERE [Email] IS NULL
                GO
                ALTER TABLE [users].[Users] ALTER COLUMN [Email] NVARCHAR(255) NOT NULL
                GO
            </sql>
        </rollback>
    </changeSet>

    <changeSet id="005_cleanup_user_roles" author="yourname" runOnChange="false" runAlways="false">
        <sqlFile path="migrations/005_cleanup_user_roles.sql" />
    </changeSet>
</databaseChangeLog>
